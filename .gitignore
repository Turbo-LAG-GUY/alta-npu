# Kept on the board only (README.md, "What's not in this repo", says why).

# Machine inventories: hostnames, package lists, device details
/audit/

# Third-party models and test images (README.md says where to get them)
/models/

# Build outputs and copied kernel sources: keep only the build record and the diff
/build/*
!/build/etnaviv-*/
/build/etnaviv-*/*
!/build/etnaviv-*/BUILDINFO.txt
!/build/etnaviv-*/ALTA-etnaviv_gpu.diff
*.ko
*.o

# Whole-boot kernel logs and journals (each incident keeps its README, summaries and job captures)
/incidents/**/journal-*.txt
/incidents/**/kernel-boot*.txt
/incidents/**/kernel-thisboot.txt

# Tray-indicator recordings (0.5 s samples, several MB)
*indicator-watch.txt

# Live NPU state, not history
/runs/STOP

# Backups and caches
*.orig-*
__pycache__/
*.pyc
.claude/settings.local.json

# Large fake-NPU dumps (weights and command streams of every model, 100-300 MB each); regenerate with
# research/port/tools/teflon_offline.sh. The results are in PROGRESS.md.
/runs/cs-offline/step6h-tiling/
/runs/cs-offline/step6i-int8nn/
/runs/cs-offline/step6i-upstream/

# Fake-NPU dumps of Mesa's Teflon test suite (1568 tests); regenerate with research/port/tools/teflon_suite_offline.sh
/runs/cs-offline/teflon-suite*/

# perf recordings: they hold kernel addresses (this boot's layout); the text reports next to them are kept
/runs/**/*.data

# NPU logits of chunk_glue runs (85 MB, regenerable with llm/l3/chunk_glue.py --save-logits): kept on the board
/runs/llm-wide-ladder-20261121-211302/x1-npu-logits.npz

# Fake-NPU dumps of the AXI SRAM limit fixes (2026-11-22, 236-425 MB each); regenerate with
# research/sram-limits/offline_check.sh. Each run's verdict is kept next to it (offline-*.VERDICT.txt).
/research/sram-limits/offline-*/

# Full-vocabulary logits dumps (50 MB each): kept on the board; each ladder directory commits logits.sha256 instead
/runs/**/*.f32
