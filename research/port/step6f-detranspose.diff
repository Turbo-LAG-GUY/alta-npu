# step 6f: partition-output detranspose for [1,1,W,C] / [1,H,1,C] (layouts_differ, was is_3d) + H = 1 TP config in
# the [1,T,1,C] form; against research/port/base-step6e (mesa-compute at step 6e; etnaviv_ml_tp.c = mesa-axi-sram's)
--- base/mesa-compute/src/gallium/drivers/etnaviv/etnaviv_ml.c
+++ mesa-compute/src/gallium/drivers/etnaviv/etnaviv_ml.c
@@ -311,12 +311,15 @@
    list_addtail(&operation->link, etna_operations);
 }
 
+/* Whether channel planes (NCHW) and channel-last (NHWC) put this tensor's bytes in a different order: only when it
+ * has more than one channel and more than one pixel. The check used to be H > 1 && W > 1 && C > 1, which also skipped
+ * [1,1,W,C] and [1,H,1,C] (the shape Teflon gives a [1,T,C] transformer tensor), so such a partition output reached
+ * the CPU still in channel planes. */
 static bool
-is_3d(struct pipe_tensor *tensor)
+layouts_differ(struct pipe_tensor *tensor)
 {
-   return tensor->dims[1] > 1 &&
-          tensor->dims[2] > 1 &&
-          tensor->dims[3] > 1;
+   return tensor->dims[3] > 1 &&
+          tensor->dims[1] * tensor->dims[2] > 1;
 }
 
 /** Tensor layout inference:
@@ -554,7 +557,7 @@
 
          ML_DBG("type %d i %d tensor %d layout %d == %d\n", poperation->type, i, poperation->output_tensors[i]->index, tensor->exp_layout, tensor->act_layout);
          if (!etna_ml_find_consumer(poperations, count, poperation->output_tensors[i]->index) &&
-             is_3d(poperation->output_tensors[i]) &&
+             layouts_differ(poperation->output_tensors[i]) &&
              tensor->exp_layout != tensor->act_layout) {
             ML_DBG("Adding detranspose.\n");
             struct etna_operation *detranspose = calloc(1, sizeof(*detranspose));
--- base/mesa-compute/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
+++ mesa-compute/src/gallium/drivers/etnaviv/etnaviv_ml_tp.c
@@ -297,6 +297,19 @@
    unsigned input_width = operation->input_width;
    unsigned input_height = operation->input_height;
    unsigned input_channels = operation->input_channels;
+
+   /* alta: the input is read as one linear run of planes and the out loops split that index, so [1,1,T,C] and
+    * [1,T,1,C] are the same permutation. Take the second form for H = 1 (the shape Teflon gives a [1,T,C]
+    * transformer tensor): no x size of 1, and the y size is C instead of T*C, which overflows its 16 bits from
+    * 128 tokens x 768 channels on. 3D tensors keep their config byte for byte. */
+   if (input_width == 1 && input_height > 1) {
+      input_width = input_height;
+      input_height = 1;
+   }
+   if (input_height * input_channels > 0xffff)
+      fprintf(stderr, "etnaviv/ml: detranspose of %ux%ux%u exceeds the TP's 16-bit y size, the output will be wrong\n",
+              operation->input_width, operation->input_height, input_channels);
+
    struct etna_bo *bo = etna_ml_create_bo(subgraph->screen, sizeof(struct etna_tp_params));
 
    etna_bo_cpu_prep(bo, DRM_ETNA_PREP_WRITE);
