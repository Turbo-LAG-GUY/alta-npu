+/* alta: whether an operand of an NN addition is already in channel planes (graph inputs are NHWC, and the producers
+ * of the other operands were lowered before, so their layouts are known) */
+static bool
+nn_eltwise_any_planar(struct etna_ml_subgraph *subgraph, const struct pipe_ml_operation *poperations, unsigned count,
+                      const struct pipe_ml_operation *poperation)
+{
+   for (unsigned j = 0; j < poperation->input_count; j++) {
+      struct pipe_tensor *ptensor = poperation->input_tensors[j];
+      if (ptensor->data != NULL || !etna_ml_find_producer(poperations, count, ptensor->index))
+         continue;
+      if (etna_ml_get_tensor(subgraph, ptensor->index)->act_layout == ETNA_ML_LAYOUT_NCHW)
+         return true;
+   }
+   return false;
+}
