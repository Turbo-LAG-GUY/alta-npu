+/*
+ * Compute dispatch on the shader core (HALTI5, compute-only contexts).
+ *
+ * Based on the 2023 etnaviv-opencl work by Tomeu Vizoso and Italo Nicola, which drove the shader core of
+ * the VIPNano-QI/GC8000 NPU (chip 0x8000 rev 0x7120 among others). The state sequence emitted for a grid
+ * is the one that branch emitted, which in turn follows the blob.
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
