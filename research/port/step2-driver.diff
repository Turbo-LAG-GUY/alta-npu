+/* Compute runs on HALTI5 cores without graphics (the NPUs' shader core): the dispatch path only exists in
+ * compute-only contexts, and a core with graphics would make st/mesa expose GL compute shaders through
+ * graphics contexts.
+ */
+static bool
+etna_compute_supported(const struct etna_screen *screen)
+{
+   return screen->info->halti >= 5 && VIV_FEATURE(screen, ETNA_FEATURE_COMPUTE_ONLY);
+}
+
+static void
+etna_init_compute_shader_caps(struct etna_screen *screen)
+{
+   struct pipe_shader_caps *caps =
+      (struct pipe_shader_caps *)&screen->base.shader_caps[MESA_SHADER_COMPUTE];
+
+   caps->max_instructions =
+   caps->max_alu_instructions = ETNA_MAX_TOKENS;
+   caps->max_control_flow_depth = ETNA_MAX_DEPTH;
+   caps->max_temps = 64;
+   /* kernel arguments are copied into uniforms when a grid is emitted */
+   caps->max_const_buffers = 1;
+   caps->max_const_buffer0_size = screen->specs.max_cs_uniforms * sizeof(float[4]);
+   caps->cont_supported = true;
+   caps->indirect_temp_addr = true;
+   caps->indirect_const_addr = true;
+   caps->tgsi_sqrt_supported = VIV_FEATURE(screen, ETNA_FEATURE_HAS_SQRT_TRIG);
+   caps->integers = true;
+   caps->supported_irs = 1 << PIPE_SHADER_IR_NIR;
+}
+
 static void
 etna_init_shader_caps(struct etna_screen *screen)
 {
    etna_init_single_shader_caps(screen, MESA_SHADER_VERTEX);
    etna_init_single_shader_caps(screen, MESA_SHADER_FRAGMENT);
+
+   if (etna_compute_supported(screen))
+      etna_init_compute_shader_caps(screen);
