+
+   if (!etna_compute_supported(screen))
+      return;
+
+   caps->address_bits = 32;
+   caps->grid_dimension = 3;
+   caps->max_grid_size[0] =
+   caps->max_grid_size[1] =
+   caps->max_grid_size[2] = 65535;
+   caps->max_block_size[0] =
+   caps->max_block_size[1] =
+   caps->max_block_size[2] = 256;
+   caps->max_threads_per_block =
+   caps->max_variable_threads_per_block = 256;
+   /* no shared (local) memory yet */
+   caps->max_local_size = 0;
+   /* not known to the driver; the A311D's NPU runs at 800 MHz */
+   caps->max_clock_frequency = 800;
+   caps->max_compute_units = MAX2(screen->info->gpu.shader_core_count, 1);
+   caps->subgroup_sizes = 4;
+   caps->max_mem_alloc_size =
