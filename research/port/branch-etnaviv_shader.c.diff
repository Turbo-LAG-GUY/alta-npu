+bool
+etna_link_compute(struct etna_context *ctx, struct etna_shader_variant *s)
+{
+   if (!etna_icache_upload_shader(ctx, s)) {
+      assert(0);
+      return false;
+   }
+
+   ctx->shader.compute->bo = s->bo;
+
+   unsigned input_count = 0;
+   if (s->workitem_funcs[0]) {
+      input_count++;
+      if (s->workitem_funcs[1]) {
+         input_count++;
+         if (s->workitem_funcs[2])
+            input_count++;
+      }
+   }
+
+   ctx->shader_state.PS_INPUT_COUNT =
+      VIVS_PS_INPUT_COUNT_COUNT(MAX2(input_count, 1)) |
+      VIVS_PS_INPUT_COUNT_UNK8(31); /* XXX what is this */
+
+   /* We have actually one more temp: the scratch register used in mem stores and img stores */
+   ctx->shader_state.PS_TEMP_REGISTER_CONTROL =
+      VIVS_PS_TEMP_REGISTER_CONTROL_NUM_TEMPS(s->num_temps + 1);
+
+   ctx->shader_state.PA_ATTRIBUTE_ELEMENT_COUNT = VIVS_PA_ATTRIBUTE_ELEMENT_COUNT_COUNT(1);
+
+   return true;
+}
