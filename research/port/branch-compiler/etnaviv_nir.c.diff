             for (unsigned i = 0; i < tex->num_srcs; i++) {
                switch (tex->src[i].src_type) {
@@ -214,3 +216,41 @@ etna_lower_alu(nir_shader *shader, bool has_new_transcendentals)
          etna_lower_alu_impl(function->impl, has_new_transcendentals);
