+static void
+lower_private_mem(struct etna_compile *c, nir_builder *b)
+{
+   if (!c->nir->scratch_size)
+      return;
+
+   /* Calculate address at the start of the kernel */
+   b->cursor = nir_before_block(nir_start_block(c->impl));
+
+   nir_ssa_def *thread_id = nir_global_atomic_add(b, 32, nir_build_imm(b, 1, 32, &THREAD_COUNTER()),
+                                                         nir_build_imm(b, 1, 32, &CONST(1)));
+   nir_ssa_def *scratch_size = nir_build_imm(b, 1, 32, &CONST(c->nir->scratch_size));
+   nir_ssa_def *thread_offset = nir_imul(b, thread_id, scratch_size);
+   nir_ssa_def *addr = nir_build_imm(b, 1, 32, &SCRATCH());
+
+   nir_ssa_def *private_slot = nir_iadd(b, addr, thread_offset);
+
+   nir_foreach_block(block, c->impl) {
+      nir_foreach_instr_safe(instr, block) {
+         switch(instr->type) {
+         case nir_instr_type_intrinsic: {
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            switch(intr->intrinsic) {
+            case nir_intrinsic_store_scratch: {
+               b->cursor = nir_after_instr(instr);
+
+               unsigned num_comp = nir_intrinsic_src_components(intr, 0);
+               nir_ssa_def *value = nir_ssa_for_src(b, intr->src[0], num_comp);
+               value = nir_channels(b, value, BITFIELD_MASK(num_comp));
+
+               nir_ssa_def *variable_offset = nir_ssa_for_src(b, intr->src[1], 1);
+
+               nir_build_store_global_ir3(b, value, private_slot, variable_offset,
+                                          .src_type = nir_intrinsic_src_type(intr));
+               nir_instr_remove(instr);
+            } break;
+            case nir_intrinsic_load_scratch: {
+               b->cursor = nir_after_instr(instr);
+
+               nir_ssa_def *variable_offset = nir_ssa_for_src(b, intr->src[0], 1);
+
+               unsigned num_comp = nir_dest_num_components(intr->dest);
+               unsigned bitsize = nir_dest_bit_size(intr->dest);
+               nir_ssa_def *def = nir_build_load_global_ir3(b, num_comp, bitsize, private_slot, variable_offset,
+                                                            .dest_type = nir_intrinsic_dest_type(intr));
+
+               nir_ssa_def_rewrite_uses(&intr->dest.ssa, def);
+               nir_instr_remove(instr);
+            } break;
+            default:
+               break;
+            }
+         default:
+            break;
+         }
+         }
+      }
+   }
+}
+
+static nir_ssa_def *
+get_shared_slot(nir_builder *b, struct etna_compile *c)
+{
+   if (c->shared_slot)
+      return c->shared_slot;
+
+   nir_ssa_def *groups_x = nir_build_imm(b, 1, 32, &GROUP_COUNT(0));
+   nir_ssa_def *groups_y = nir_build_imm(b, 1, 32, &GROUP_COUNT(1));
+
+   nir_ssa_def *group_id_x = nir_channel(b, nir_load_workgroup_id(b, 32), 0);
+   nir_ssa_def *group_id_y = nir_channel(b, nir_load_workgroup_id(b, 32), 1);
+   group_id_y = nir_imul(b, group_id_y, groups_x);
+
+   nir_ssa_def *group_id_z = nir_channel(b, nir_load_workgroup_id(b, 32), 2);
+   group_id_z = nir_imul(b, group_id_z, groups_x);
+   group_id_z = nir_imul(b, group_id_z, groups_y);
+
+   nir_ssa_def *group_id = nir_iadd(b, nir_iadd(b, group_id_x, group_id_y), group_id_z);
+
+   nir_ssa_def *shared_size = nir_build_imm(b, 1, 32, &SHARED_SIZE());
+   nir_ssa_def *group_offset = nir_imul(b, group_id, shared_size);
+
+   nir_ssa_def *addr = nir_build_imm(b, 1, 32, &SHARED());
+
+   c->shared_slot = nir_iadd(b, addr, group_offset);
+
+   return c->shared_slot;
+}
+
+static void
+lower_shared_mem(struct etna_compile *c, nir_builder *b)
+{
+   nir_foreach_block(block, c->impl) {
+      nir_foreach_instr_safe(instr, block) {
+         switch(instr->type) {
+         case nir_instr_type_intrinsic: {
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            switch(intr->intrinsic) {
+            case nir_intrinsic_store_shared: {
+               b->cursor = nir_after_instr(instr);
+
+               unsigned num_comp = nir_intrinsic_src_components(intr, 0);
+               nir_ssa_def *value = nir_ssa_for_src(b, intr->src[0], num_comp);
+               value = nir_channels(b, value, BITFIELD_MASK(num_comp));
+
+               nir_ssa_def *variable_offset = nir_ssa_for_src(b, intr->src[1], 1);
+               nir_ssa_def *shared_slot = get_shared_slot(b, c);
+               nir_build_store_global_ir3(b, value, shared_slot, variable_offset,
+                                          .src_type = nir_intrinsic_src_type(intr));
+
+               nir_instr_remove(instr);
+            } break;
+            case nir_intrinsic_load_shared: {
+               b->cursor = nir_after_instr(instr);
+
+               nir_ssa_def *variable_offset = nir_ssa_for_src(b, intr->src[0], 1);
+               nir_ssa_def *shared_slot = get_shared_slot(b, c);
+
+               unsigned num_comp = nir_dest_num_components(intr->dest);
+               unsigned bitsize = nir_dest_bit_size(intr->dest);
+
+               nir_ssa_def *def = nir_build_load_global_ir3(b, num_comp, bitsize, shared_slot, variable_offset,
+                                                            .dest_type = nir_intrinsic_dest_type(intr));
+
+               nir_ssa_def_rewrite_uses(&intr->dest.ssa, def);
+               nir_instr_remove(instr);
+            } break;
+            case nir_intrinsic_shared_atomic_add:
+            case nir_intrinsic_shared_atomic_and:
+            case nir_intrinsic_shared_atomic_or:
+            case nir_intrinsic_shared_atomic_xor:
+            case nir_intrinsic_shared_atomic_exchange:
+            case nir_intrinsic_shared_atomic_comp_swap:
+            case nir_intrinsic_shared_atomic_imax:
+            case nir_intrinsic_shared_atomic_imin:
+            case nir_intrinsic_shared_atomic_umax:
+            case nir_intrinsic_shared_atomic_umin: {
+               b->cursor = nir_before_instr(instr);
+
+               nir_ssa_def *offset = nir_ssa_for_src(b, intr->src[0], 1);
+               nir_ssa_def *addr = get_shared_slot(b, c);
+               addr = nir_iadd(b, addr, offset);
+
+               nir_instr_rewrite_src(&intr->instr, &intr->src[0], nir_src_for_ssa(addr));
+            } break;
+            default:
+               break;
+            }
+         default:
+            break;
+         }
+         }
+      }
+   }
+}
