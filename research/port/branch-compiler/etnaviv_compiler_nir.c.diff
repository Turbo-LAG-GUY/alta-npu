+// TODO: how to better handle types?
+static unsigned
+etna_get_inst_type_from_nir(nir_intrinsic_op op, unsigned bitsize)
+{
+   unsigned type;
+   bool is_signed;
+
+   switch (op) {
+      case nir_intrinsic_global_atomic_imax:
+      case nir_intrinsic_shared_atomic_imax:
+      case nir_intrinsic_global_atomic_imin:
+      case nir_intrinsic_shared_atomic_imin:
+         is_signed = true;
+         break;
+      default:
+         is_signed = false;
+   }
+
+   switch (bitsize) {
+      case 32:
+         type = is_signed ? INST_TYPE_S32 : INST_TYPE_U32;
+         break;
+      case 16:
+         type = is_signed ? INST_TYPE_S16 : INST_TYPE_U16;
+         break;
+      case 8:
+         type = is_signed ? INST_TYPE_S8 : INST_TYPE_U8;
+         break;
+      default:
+         assert(false && "Unhandled bitsize");
+         break;
+   }
+
+   return type;
+}
+
+static unsigned
+etna_atomic_op_from_nir(nir_intrinsic_op nir)
+{
+   switch (nir) {
+   case nir_intrinsic_global_atomic_add:
+   case nir_intrinsic_shared_atomic_add:
+      return INST_OPCODE_ATOM_ADD;
+   case nir_intrinsic_global_atomic_and:
+   case nir_intrinsic_shared_atomic_and:
+      return INST_OPCODE_ATOM_AND;
+   case nir_intrinsic_global_atomic_or:
+   case nir_intrinsic_shared_atomic_or:
+      return INST_OPCODE_ATOM_OR;
+   case nir_intrinsic_global_atomic_xor:
+   case nir_intrinsic_shared_atomic_xor:
+      return INST_OPCODE_ATOM_XOR;
+   case nir_intrinsic_global_atomic_exchange:
+   case nir_intrinsic_shared_atomic_exchange:
+      return INST_OPCODE_ATOM_XCHG;
+   case nir_intrinsic_global_atomic_comp_swap:
+   case nir_intrinsic_shared_atomic_comp_swap:
+      return INST_OPCODE_ATOM_CMP_XCHG;
+   case nir_intrinsic_global_atomic_imax:
+   case nir_intrinsic_shared_atomic_imax:
+   case nir_intrinsic_global_atomic_umax:
+   case nir_intrinsic_shared_atomic_umax:
+      return INST_OPCODE_ATOM_MAX;
+   case nir_intrinsic_global_atomic_imin:
+   case nir_intrinsic_shared_atomic_imin:
+   case nir_intrinsic_global_atomic_umin:
+   case nir_intrinsic_shared_atomic_umin:
+      return INST_OPCODE_ATOM_MIN;
+   default:
+      unreachable("Unhandled atomic NIR op");
+      return 0;
+   }
+}
+
+static unsigned
+etna_get_inst_type_from_nir2(nir_alu_type nir_type, unsigned bitsize)
+{
+   switch (nir_alu_type_get_base_type(nir_type)) {
+      case nir_type_int:
+         return bitsize == 8 ? INST_TYPE_S8 :
+                bitsize == 16 ? INST_TYPE_S16 :
+                INST_TYPE_S32;
+      case nir_type_uint:
+         return bitsize == 8 ? INST_TYPE_U8 :
+                bitsize == 16 ? INST_TYPE_U16 :
+                INST_TYPE_U32;
+      case nir_type_float:
+         return bitsize == 16 ? INST_TYPE_F16 :
+                INST_TYPE_F32;
+      case nir_type_bool:
+         return INST_TYPE_U8;
+      default:
+         unreachable("Unhandled base type.");
+         return 0;
+   }
+}
