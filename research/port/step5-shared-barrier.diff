+/* compute: shared (workgroup-local) memory is emulated in DDR, as the 2023 etnaviv-opencl driver did: the driver
+ * allocates one slice of v->shared_size bytes per workgroup of a grid, and a workgroup's slice starts at
+ *    shared base + (id.x + count.x * (id.y + count.y * id.z)) * shared_size
+ * The slice address is computed once at the start of the shader; shared loads/stores become global loads/stores on
+ * slice + offset (the path proven on the NPU's shader core). load_shared_base_ptr and load_num_workgroups become
+ * driver-filled uniforms in emit_shader. Barriers that order shared memory now also order global memory, so no pass
+ * moves the lowered accesses across them.
+ */
+static nir_def *
+etna_shared_slot(nir_builder *b, unsigned shared_size)
+{
+   nir_def *id = nir_load_workgroup_id(b);
+   nir_def *count = nir_load_num_workgroups(b);
+   nir_def *yz = nir_iadd(b, nir_channel(b, id, 1), nir_imul(b, nir_channel(b, count, 1), nir_channel(b, id, 2)));
+   nir_def *linear = nir_iadd(b, nir_channel(b, id, 0), nir_imul(b, nir_channel(b, count, 0), yz));
+
+   return nir_iadd(b, nir_load_shared_base_ptr(b, 1, 32), nir_imul_imm(b, linear, shared_size));
+}
+
+static bool
+etna_lower_shared_to_global(nir_shader *s, unsigned shared_size)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(s);
+   nir_builder b = nir_builder_create(impl);
+   nir_def *slot = NULL;
+   bool progress = false;
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+
+         if (intr->intrinsic == nir_intrinsic_barrier) {
+            nir_variable_mode modes = nir_intrinsic_memory_modes(intr);
+            if (modes & nir_var_mem_shared)
+               nir_intrinsic_set_memory_modes(intr, modes | nir_var_mem_global);
+            continue;
+         }
+
+         if (intr->intrinsic != nir_intrinsic_load_shared && intr->intrinsic != nir_intrinsic_store_shared)
+            continue;
+
+         if (!slot) {
+            b.cursor = nir_before_impl(impl);
+            slot = etna_shared_slot(&b, shared_size);
+         }
+
+         b.cursor = nir_before_instr(instr);
+         const bool is_load = intr->intrinsic == nir_intrinsic_load_shared;
+         nir_def *offset = intr->src[is_load ? 0 : 1].ssa;
+         nir_def *addr = nir_iadd(&b, slot, nir_iadd_imm(&b, offset, nir_intrinsic_base(intr)));
+
+         if (is_load) {
+            nir_def *def = nir_load_global(&b, intr->def.num_components, intr->def.bit_size, addr,
+                                           .align_mul = nir_intrinsic_align_mul(intr),
+                                           .align_offset = nir_intrinsic_align_offset(intr));
+            nir_def_replace(&intr->def, def);
+         } else {
+            nir_store_global(&b, intr->src[0].ssa, addr,
+                             .write_mask = nir_intrinsic_write_mask(intr),
+                             .align_mul = nir_intrinsic_align_mul(intr),
+                             .align_offset = nir_intrinsic_align_offset(intr));
+            nir_instr_remove(instr);
+         }
+         progress = true;
+      }
+   }
+
+   return nir_progress(progress, impl, nir_metadata_control_flow);
+}
