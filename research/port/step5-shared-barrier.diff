+/* The checks of etna_compute_uniforms_write, made before anything is emitted: a uniform the driver can't fill
+ * would be written as 0, and a zero address sends the shader to unmapped memory (an MMU fault), so such a grid is
+ * refused instead.
+ */
+static bool
+etna_compute_uniforms_check(struct etna_context *ctx, const struct etna_shader_variant *v)
+{
+   const struct etna_shader_uniform_info *uinfo = &v->uniforms;
+   const struct pipe_constant_buffer *cb = ctx->constant_buffer[MESA_SHADER_COMPUTE].cb;
+
+   for (uint32_t i = 0; i < uinfo->count; i++) {
+      const uint32_t val = uinfo->data[i];
+
+      switch (uinfo->contents[i]) {
+      case ETNA_UNIFORM_CONSTANT:
+      case ETNA_UNIFORM_GROUP_COUNT:
+      case ETNA_UNIFORM_UNUSED:
+         break;
+      case ETNA_UNIFORM_KERNEL_ARG: {
+         const unsigned offset = ETNA_KERNEL_ARG_OFFSET(val), size = ETNA_KERNEL_ARG_SIZE(val);
+         if (!cb[0].user_buffer || size > 4 || offset + size > cb[0].buffer_size)
+            return false;
+         break;
+      }
+      case ETNA_UNIFORM_UNIFORM:
+         if (!cb[0].user_buffer || (val + 1) * 4 > cb[0].buffer_size)
+            return false;
+         break;
+      case ETNA_UNIFORM_UBO_ADDR:
+         if (!cb[val].buffer)
+            return false;
+         break;
+      case ETNA_UNIFORM_SHARED_ADDR:
+         if (!v->shared_size || !ctx->compute_shared)
+            return false;
+         break;
+      default:
+         return false;
+      }
+   }
+
+   return true;
+}
+
+/* Shared memory of a grid: one slice of v->shared_size bytes per workgroup, in one buffer that grows as needed and
+ * is kept for later grids (see etna_lower_shared_to_global for the addressing).
+ */
+static bool
+etna_compute_shared_alloc(struct etna_context *ctx, const struct etna_shader_variant *v,
+                          const struct pipe_grid_info *info)
+{
+   if (!v->shared_size)
+      return true;
+
+   const uint64_t groups = (uint64_t)info->grid[0] * info->grid[1] * info->grid[2];
+   const uint64_t bytes = groups * v->shared_size;
+
+   if (bytes > ctx->base.screen->compute_caps.max_global_size)
+      return false;
+
+   if (!ctx->compute_shared || ctx->compute_shared->width0 < bytes) {
+      pipe_resource_reference(&ctx->compute_shared, NULL);
+      ctx->compute_shared = pipe_buffer_create(ctx->base.screen, PIPE_BIND_GLOBAL, PIPE_USAGE_DEFAULT,
+                                               MAX2(bytes, 4096));
+   }
+
+   return ctx->compute_shared != NULL;
+}
