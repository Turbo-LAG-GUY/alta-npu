+/*
+ * --kernel eltwise (step 6g): the driver's elementwise lookup kernel (etna_ml_shader_build_eltwise) on output channel
+ * planes of P = H*W positions x C channels, with a synthetic table (a pseudo-random byte function, so every operand
+ * byte and every index bit matters) instead of a TFLite formula: this tests the kernel's addressing (operand modes,
+ * byte packing, the 2D grid), the tables themselves are checked against TFLite offline
+ * (research/port/tools/eltwise_table_check.py). --modes M[,M]: one or two of full, pos, chan, scalar. The output
+ * buffer has 4 KiB of 0xdeadbeef after the P*C bytes: any write there is a stray write.
+ */
+static uint32_t
+elt_table_fn(uint32_t idx)
+{
+   uint32_t x = idx * 2654435761u + 0x9e3779b9u;
+   x ^= x >> 15;
+   x *= 0x85ebca6bu;
+   x ^= x >> 13;
+   return x & 0xff;
+}
+
+static int
+run_eltwise(bool offline, unsigned H, unsigned W, unsigned C, const char *modes_arg, unsigned repeat)
+{
+   const unsigned P = H * W;
+   enum etna_ml_eltwise_mode modes[2];
+   unsigned operands = 0;
+   char buf[64];
+   snprintf(buf, sizeof(buf), "%s", modes_arg ? modes_arg : "full,full");
+   for (char *t = strtok(buf, ","); t && operands < 2; t = strtok(NULL, ",")) {
+      if (!strcmp(t, "full"))
+         modes[operands++] = ETNA_ML_ELTWISE_FULL;
+      else if (!strcmp(t, "pos"))
+         modes[operands++] = ETNA_ML_ELTWISE_POS;
+      else if (!strcmp(t, "chan"))
+         modes[operands++] = ETNA_ML_ELTWISE_CHAN;
+      else if (!strcmp(t, "scalar"))
+         modes[operands++] = ETNA_ML_ELTWISE_SCALAR;
+      else {
+         fprintf(stderr, "eltwise: --modes full|pos|chan|scalar[,...]\n");
+         return 2;
+      }
+   }
+   if (!P || P % 4 || !C || !operands) {
+      fprintf(stderr, "eltwise: --hwc H W C with H*W %% 4 == 0, --modes M[,M]\n");
+      return 2;
+   }
+   const unsigned gx = P / 4;
+   unsigned bw = 64;
+   while (bw > 1 && gx % bw)
+      bw /= 2;
+
+   step("open: begin");
+   int fd = open_etnaviv(offline);
+   if (fd < 0) {
+      fprintf(stderr, "no etnaviv render node\n");
+      return 2;
+   }
+   struct pipe_screen *ps = etna_drm_screen_create(fd);
+   struct pipe_context *pc = ps ? ps->context_create(ps, NULL, PIPE_CONTEXT_COMPUTE_ONLY) : NULL;
+   if (!pc || !pc->launch_grid) {
+      fprintf(stderr, "no compute context\n");
+      return 2;
+   }
+   step("context: done");
+   nir_shader *nir = etna_ml_shader_build_eltwise(ps->nir_options[MESA_SHADER_COMPUTE], operands, modes);
+   nir_print_shader(nir, stdout);
+   struct pipe_compute_state cs = { .ir_type = PIPE_SHADER_IR_NIR, .prog = nir };
+   void *cso = pc->create_compute_state(pc, &cs);
+   if (!cso) {
+      fprintf(stderr, "create_compute_state failed\n");
+      return 2;
+   }
+   pc->bind_compute_state(pc, cso);
+   step("compute state: created");
+
+   /* operand sizes by mode; buffers padded to whole words + 4 KiB */
+   size_t osz[2];
+   for (unsigned o = 0; o < operands; o++)
+      osz[o] = modes[o] == ETNA_ML_ELTWISE_FULL ? (size_t)P * C : modes[o] == ETNA_ML_ELTWISE_POS ? P
+             : modes[o] == ETNA_ML_ELTWISE_CHAN ? C : 1;
+   const size_t out_bytes = (size_t)P * C, out_buf = out_bytes + 4096;
+   const unsigned twords = operands == 2 ? 65536 : 256;
+   uint8_t *opd[2] = { NULL, NULL };
+   uint32_t x = 0x2545f491u;
+   for (unsigned o = 0; o < operands; o++) {
+      opd[o] = calloc(1, (osz[o] + 3) / 4 * 4 + 4096);
+      for (size_t i = 0; i < osz[o]; i++) {
+         x ^= x << 13;
+         x ^= x >> 17;
+         x ^= x << 5;
+         opd[o][i] = (uint8_t)(x >> 24);
+      }
+   }
+   uint32_t *table = malloc(twords * 4), *outw = malloc(out_buf);
+   for (unsigned i = 0; i < twords; i++)
+      table[i] = elt_table_fn(i);
+   for (size_t i = 0; i < out_buf / 4; i++)
+      outw[i] = 0xdeadbeef;
+
+   struct pipe_resource *res[4] = { NULL, NULL, NULL, NULL };
+   res[0] = pipe_buffer_create(ps, PIPE_BIND_GLOBAL, PIPE_USAGE_DEFAULT, out_buf);
+   res[1] = pipe_buffer_create(ps, PIPE_BIND_GLOBAL, PIPE_USAGE_DEFAULT, twords * 4);
+   pipe_buffer_write(pc, res[0], 0, out_buf, outw);
+   pipe_buffer_write(pc, res[1], 0, twords * 4, table);
+   for (unsigned o = 0; o < operands; o++) {
+      const size_t sz = (osz[o] + 3) / 4 * 4 + 4096;
+      res[2 + o] = pipe_buffer_create(ps, PIPE_BIND_GLOBAL, PIPE_USAGE_DEFAULT, sz);
+      pipe_buffer_write(pc, res[2 + o], 0, sz, opd[o]);
+   }
+   uint32_t addr[4] = { 0, 0, 0, 0 };
+   uint32_t *handles[4] = { &addr[0], &addr[1], &addr[2], &addr[3] };
+   pc->set_global_binding(pc, 0, 2 + operands, res, handles);
+   printf("GPU addresses: out 0x%x table 0x%x operands 0x%x 0x%x\n", addr[0], addr[1], addr[2], addr[3]);
+
+   uint32_t args[8] = { addr[0], addr[2], operands == 2 ? addr[3] : 0, addr[1], P, gx - 1, C - 1, 0 };
+   pc->set_constant_buffer(pc, MESA_SHADER_COMPUTE, 0,
+                           &(struct pipe_constant_buffer){ .user_buffer = args, .buffer_size = sizeof(args) });
+   struct pipe_grid_info g = { .work_dim = 2, .block = { bw, 1, 1 }, .grid = { gx / bw, C, 1 } };
+   printf("grid: %u x %u workgroups of %u x 1 threads, %u operand(s)\n", g.grid[0], g.grid[1], bw, operands);
+   double *times = calloc(repeat, sizeof(double)), first_ms = 0;
+   for (unsigned r = 0; r < repeat; r++) {
+      step(r == 0 ? "launch 1: begin" : "launch: begin");
+      struct timespec t0, t1;
+      clock_gettime(CLOCK_MONOTONIC, &t0);
+      pc->launch_grid(pc, &g);
+      struct pipe_fence_handle *fence = NULL;
+      pc->flush(pc, &fence, 0);
+      bool done = fence && ps->fence_finish(ps, NULL, fence, 3000000000ull);
+      ps->fence_reference(ps, &fence, NULL);
+      clock_gettime(CLOCK_MONOTONIC, &t1);
+      times[r] = (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6;
+      if (!r)
+         first_ms = times[r];
+      if (!done) {
+         step("launch: fence wait FAILED");
+         printf("{\"result\": \"TIMEOUT\", \"launch\": %u}\n", r + 1);
+         return 4;
+      }
+   }
+   step("launches: done");
+   unsigned m = repeat > 1 ? repeat - 1 : 1;
+   double *t = repeat > 1 ? times + 1 : times;
+   for (unsigned i = 0; i < m; i++)
+      for (unsigned j = i + 1; j < m; j++)
+         if (t[j] < t[i]) {
+            double v = t[i];
+            t[i] = t[j];
+            t[j] = v;
+         }
+   pipe_buffer_read(pc, res[0], 0, out_buf, outw);
+   const uint8_t *out8 = (const uint8_t *)outw;
+   unsigned wrong = 0, stray = 0;
+   for (unsigned c = 0; c < C; c++)
+      for (unsigned p = 0; p < P; p++) {
+         unsigned k[2] = { 0, 0 };
+         for (unsigned o = 0; o < operands; o++)
+            k[o] = opd[o][modes[o] == ETNA_ML_ELTWISE_FULL ? (size_t)c * P + p : modes[o] == ETNA_ML_ELTWISE_POS ? p
+                          : modes[o] == ETNA_ML_ELTWISE_CHAN ? c : 0];
+         const uint32_t want = elt_table_fn(operands == 2 ? k[0] * 256 + k[1] : k[0]);
+         const uint8_t got = out8[(size_t)c * P + p];
+         if (got != want) {
+            if (wrong < 8)
+               printf("c %u p %u: got %u want %u (operands %u %u)\n", c, p, got, want, k[0], k[1]);
+            wrong++;
+         }
+      }
+   const uint32_t fill = 0xdeadbeef;
+   for (size_t i = out_bytes; i < out_buf; i++)
+      stray += out8[i] != ((const uint8_t *)&fill)[i % 4];
+   const char *res_s = offline ? "OFFLINE" : (wrong || stray ? "MISMATCH" : "PASS");
+   printf("eltwise %s%s%s: %u positions x %u channels: %zu outputs, %u wrong, %u stray bytes\n",
+          modes_arg ? modes_arg : "full,full", "", "", P, C, out_bytes, wrong, stray);
+   printf("{\"result\": \"%s\", \"kernel\": \"eltwise\", \"modes\": \"%s\", \"positions\": %u, \"channels\": %u, "
+          "\"wrong\": %u, \"stray\": %u, \"first_launch_ms\": %.3f, \"median_ms\": %.3f, \"launches\": %u}\n",
+          res_s, modes_arg ? modes_arg : "full,full", P, C, wrong, stray, first_ms, t[m / 2], repeat);
+   step("finished");
+   pc->set_global_binding(pc, 0, 2 + operands, NULL, NULL);
+   for (unsigned r = 0; r < 4; r++)
+      pipe_resource_reference(&res[r], NULL);
+   pc->delete_compute_state(pc, cso);
+   pc->destroy(pc);
+   ps->destroy(ps);
+   return offline ? 0 : (wrong || stray ? 3 : 0);
+}
