+static uint32_t
+get_dimension(struct pipe_resource *resource, enum etna_uniform_contents contents, uint32_t index)
+{
+   /* TODO: The blob seems to shove more than one value in order to save uniform registers */
+   switch (contents) {
+      case ETNA_UNIFORM_SAMPLER_WIDTH:
+      case ETNA_UNIFORM_IMAGE_WIDTH:
+         return resource->width0;
+      case ETNA_UNIFORM_SAMPLER_HEIGHT:
+      case ETNA_UNIFORM_IMAGE_HEIGHT:
+         return resource->height0;
+      case ETNA_UNIFORM_SAMPLER_DEPTH:
+      case ETNA_UNIFORM_IMAGE_DEPTH:
+         return resource->depth0;
+      default:
+         unreachable("Invalid uniform content type");
+   }
+}
+
+static unsigned
+get_format_type(const struct util_format_description *desc)
+{
+   switch(desc->channel[0].type) {
+      case UTIL_FORMAT_TYPE_SIGNED:
+         switch(desc->channel[0].size) {
+            case 8:
+               return CL_CHANNEL_TYPE_SINT8;
+            case 16:
+               return CL_CHANNEL_TYPE_SINT16;
+            case 32:
+               return CL_CHANNEL_TYPE_SINT32;
+            default:
+               unreachable("Unhandled channel size for signed integers.");
+         }
+      case UTIL_FORMAT_TYPE_UNSIGNED:
+         switch(desc->channel[0].size) {
+            case 8:
+               return CL_CHANNEL_TYPE_UINT8;
+            case 16:
+               return CL_CHANNEL_TYPE_UINT16;
+            case 32:
+               return CL_CHANNEL_TYPE_UINT32;
+            default:
+               unreachable("Unhandled channel size for unsigned integers.");
+         }
+      case UTIL_FORMAT_TYPE_FLOAT:
+         switch(desc->channel[0].size) {
+            case 16:
+               return CL_CHANNEL_TYPE_HALF;
+            case 32:
+               return CL_CHANNEL_TYPE_FLOAT;
+            default:
+               unreachable("Unhandled channel size for floats.");
+         }
+      default:
+         unreachable("Unhandled channel type.");
+   }
+}
+
+static unsigned
+get_channel_order(const struct util_format_description *desc)
+{
+   if (desc->swizzle[0] == PIPE_SWIZZLE_X &&
+       desc->swizzle[1] == PIPE_SWIZZLE_Y &&
+       desc->swizzle[2] == PIPE_SWIZZLE_Z &&
+       desc->swizzle[3] == PIPE_SWIZZLE_W)
+      return CL_CHANNEL_ORDER_RGBA;
+   else if (desc->swizzle[0] == PIPE_SWIZZLE_Z &&
+       desc->swizzle[1] == PIPE_SWIZZLE_Y &&
+       desc->swizzle[2] == PIPE_SWIZZLE_X &&
+       desc->swizzle[3] == PIPE_SWIZZLE_W)
+      return CL_CHANNEL_ORDER_BGRA;
+   else if (desc->swizzle[0] == PIPE_SWIZZLE_X &&
+       desc->swizzle[1] == PIPE_SWIZZLE_Y &&
+       desc->swizzle[2] == PIPE_SWIZZLE_Z &&
+       desc->swizzle[3] == PIPE_SWIZZLE_1)
+      return CL_CHANNEL_ORDER_RGB;
+   else if (desc->swizzle[0] == PIPE_SWIZZLE_X &&
+       desc->swizzle[1] == PIPE_SWIZZLE_Y &&
+       desc->swizzle[2] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[3] == PIPE_SWIZZLE_1)
+      return CL_CHANNEL_ORDER_RG;
+   else if (desc->swizzle[0] == PIPE_SWIZZLE_X &&
+       desc->swizzle[1] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[2] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[3] == PIPE_SWIZZLE_Y)
+      return CL_CHANNEL_ORDER_RA;
+   else if (desc->swizzle[0] == PIPE_SWIZZLE_X &&
+       desc->swizzle[1] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[2] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[3] == PIPE_SWIZZLE_1)
+      return CL_CHANNEL_ORDER_R;
+   else if (desc->swizzle[0] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[1] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[2] == PIPE_SWIZZLE_0 &&
+       desc->swizzle[3] == PIPE_SWIZZLE_X)
+      return CL_CHANNEL_ORDER_A;
+   else {
+      unreachable("Unhandled channel order.");
+   }
+}
+
+static unsigned
+get_bpp_value(const struct util_format_description *desc)
+{
+   switch(desc->block.bits / 8) {
+      case 16:
+         return 0x4;
+      case 8:
+         return 0x3;
+      case 4:
+         return 0x2;
+      case 2:
+         return 0x1;
+      case 1:
+         return 0x0;
+      default:
+         unreachable("Unhandled block bit size");
+   }
+}
+
+static unsigned
+get_amode(const struct pipe_sampler_state *sampler)
+{
+   /* OpenCL supports only a single addressing mode per sampler, so use `r` */
+   switch(sampler->wrap_r) {
+      case 0:
+         return 0;
+      case PIPE_TEX_WRAP_CLAMP_TO_BORDER:
+         return 1;
+      case PIPE_TEX_WRAP_CLAMP_TO_EDGE:
+         return 3;
+      /* PIPE_TEX_WRAP_*_REPEAT are implemented in the kernel */
+      default:
+            unreachable("Unhandled block bit size");
+   }
+}
