+/* loopsum (step 6e, the first kernel with control flow): thread i sums n words, out[i] = sum of in[i + k * S / 4]
+ * for k < n, in a real loop (n is a kernel argument, so the compiler can't unroll it; capped at CS_LOOP_MAX inside the
+ * kernel so a wrong argument can't make it run away). Kernel input: out, in, n, S (bytes between the words). */
+#define CS_LOOP_MAX 4096
+
+static nir_shader *
+cs_build_loopsum(const nir_shader_compiler_options *opts)
+{
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_KERNEL, opts, "loopsum");
+   b.shader->info.workgroup_size_variable = true;
+
+   nir_def *i = nir_channel(&b, nir_load_global_invocation_id(&b, 32), 0);
+   nir_def *out_addr = cs_arg(&b, 0, 16), *in_addr = cs_arg(&b, 1, 16);
+   nir_def *n = nir_umin(&b, cs_arg(&b, 2, 16), nir_imm_int(&b, CS_LOOP_MAX)), *stride = cs_arg(&b, 3, 16);
+
+   nir_variable *acc_v = nir_local_variable_create(b.impl, glsl_uint_type(), "acc");
+   nir_variable *k_v = nir_local_variable_create(b.impl, glsl_uint_type(), "k");
+   nir_variable *addr_v = nir_local_variable_create(b.impl, glsl_uint_type(), "addr");
+   nir_store_var(&b, acc_v, nir_imm_int(&b, 0), 0x1);
+   nir_store_var(&b, k_v, nir_imm_int(&b, 0), 0x1);
+   nir_store_var(&b, addr_v, nir_iadd(&b, in_addr, nir_ishl_imm(&b, i, 2)), 0x1);
+
+   nir_loop *loop = nir_push_loop(&b);
+   {
+      nir_def *k = nir_load_var(&b, k_v);
+      nir_push_if(&b, nir_uge(&b, k, n));
+      nir_jump(&b, nir_jump_break);
+      nir_pop_if(&b, NULL);
+
+      nir_def *addr = nir_load_var(&b, addr_v);
+      nir_def *w = nir_load_global(&b, 1, 32, addr, .align_mul = 4);
+      nir_store_var(&b, acc_v, nir_iadd(&b, nir_load_var(&b, acc_v), w), 0x1);
+      nir_store_var(&b, addr_v, nir_iadd(&b, addr, stride), 0x1);
+      nir_store_var(&b, k_v, nir_iadd_imm(&b, k, 1), 0x1);
+   }
+   nir_pop_loop(&b, loop);
+
+   nir_store_global(&b, nir_load_var(&b, acc_v), nir_iadd(&b, out_addr, nir_ishl_imm(&b, i, 2)), .write_mask = 0x1,
+                    .align_mul = 4);
+   return b.shader;
+}
+
 #endif
