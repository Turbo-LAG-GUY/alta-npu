# step 6h: v7 NN tiling for tiles wider than the image ([1,H,1,C] and H > W, W < 64), against research/port/base-step6h
# (= mesa-axi-sram's etnaviv_ml_nn_v7.c; earlier steps never touched it)
--- base/mesa-compute/src/gallium/drivers/etnaviv/etnaviv_ml_nn_v7.c
+++ mesa-compute/src/gallium/drivers/etnaviv/etnaviv_ml_nn_v7.c
@@ -86,6 +86,17 @@
       output_height *= 2;
    }
 
+   /* alta: the NN config's x size is output_height and its y size output_width (etnaviv_ml_nn.c swaps them before
+    * filling the map), but the tile is computed from them unswapped. Where that makes the tile wider than the image
+    * ([1,H,1,C] with H > W, W < 64: a 64 x 1 tile on a 1 x 64 image), the NN job never finishes (incidents
+    * 2026-11-14-0020-S6F-C64x1-OFF, -0127-S6F-W1-NN). Only there, tile the image as it is configured; every other
+    * tiling (square images, H < W, H = 1) stays as it was. */
+   if (!operation->fully_connected && MIN2(output_width, 64) > output_height) {
+      unsigned t = output_width;
+      output_width = output_height;
+      output_height = t;
+   }
+
    tile_width = MIN2(output_width, 64);
    interleave_mode = calc_interleave_mode(tile_width, operation->weight_height);
 
