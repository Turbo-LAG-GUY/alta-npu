From 940b610ac79f7704265fe317a6b27f67553eff61 Mon Sep 17 00:00:00 2001
From: Jordan Williams Johnson <jordandwj@gmail.com>
Date: Fri, 20 Nov 2026 04:03:27 -0500
Subject: [PATCH 12/12] etnaviv/ml: Convert signed tensors eight bytes at a
 time

The NPU works on unsigned bytes, so 128 is added to signed inputs on
the way in and subtracted from outputs on the way out, one byte at a
time in a loop GCC does not vectorize. Adding or subtracting 128 flips
the top bit of each byte: do it with 64-bit XORs, straight from a
cached output buffer, or after the bulk copy for a write-combined one.
etna_buffer_cpu_read_cached() tells the two apart for the allocator
and the read-out alike.

On a VIPNano-QI.7120 (A311D), reading back a 786 KB int8 output went
from 1.5 ms to 0.54 ms and writing a 147 KB input from 0.26 ms to
0.10 ms; a 256-token convolution through Teflon from 6.28 ms to
4.04 ms per invoke. Outputs are unchanged.

Generated-by: LLM
---
 src/gallium/drivers/etnaviv/etnaviv_ml.c      | 52 ++++++++++++++-----
 .../drivers/etnaviv/etnaviv_resource.c        |  2 +-
 .../drivers/etnaviv/etnaviv_resource.h        | 10 ++++
 3 files changed, 50 insertions(+), 14 deletions(-)

diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml.c b/src/gallium/drivers/etnaviv/etnaviv_ml.c
index 24812bd45e73..22a06ef74301 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_ml.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml.c
@@ -100,6 +100,26 @@ etna_ml_destroy_tensor(struct etna_ml_subgraph *subgraph, unsigned idx)
    tensor->size = 0;
 }
 
+/* The NPU works on unsigned bytes: a signed tensor goes in and comes out with
+ * 128 added. Adding or subtracting 128 flips the top bit of each byte, which
+ * is done here eight bytes at a time.
+ */
+static void
+flip_sign_bits(uint8_t *dst, const uint8_t *src, unsigned size)
+{
+   unsigned k = 0;
+
+   for (; k + 8 <= size; k += 8) {
+      uint64_t v;
+      memcpy(&v, src + k, sizeof(v));
+      v ^= 0x8080808080808080ull;
+      memcpy(dst + k, &v, sizeof(v));
+   }
+
+   for (; k < size; k++)
+      dst[k] = src[k] ^ 0x80;
+}
+
 struct etna_bo *
 etna_ml_create_bo(struct etna_screen *screen, size_t size)
 {
@@ -1004,13 +1024,10 @@ etna_ml_subgraph_invoke(struct pipe_context *pctx, struct pipe_ml_subgraph *psub
       struct etna_ml_tensor *tensor = etna_ml_get_tensor(subgraph, input_idxs[i]);
       if (is_signed[i]) {
          struct pipe_transfer *dst_transfer;
-         const uint8_t *src = inputs[i];
          uint8_t *dst_map;
          dst_map = pipe_buffer_map_range(pctx, tensor->resource, tensor->offset, tensor->size, PIPE_MAP_WRITE, &dst_transfer);
          assert(dst_map);
-         for (unsigned k = 0; k < tensor->size; k++) {
-            dst_map[k] = src[k] + 128;
-         }
+         flip_sign_bits(dst_map, inputs[i], tensor->size);
          pipe_buffer_unmap(pctx, dst_transfer);
       } else {
          pctx->buffer_subdata(pctx, tensor->resource, PIPE_MAP_DIRECTLY,
@@ -1144,16 +1161,25 @@ etna_ml_subgraph_read_outputs(struct pipe_context *context, struct pipe_ml_subgr
       struct pipe_resource *res = etna_ml_get_resource(subgraph, output_idxs[i]);
       unsigned size = etna_ml_get_size(subgraph, output_idxs[i]);
 
-      /* The tensor buffers are write-combined: copy each output out in
-       * one bulk read and convert it in cached memory, instead of doing one
-       * uncached load per byte.
-       */
-      pipe_buffer_read(context, res, 0, size, outputs[i]);
-      if (is_signed[i]) {
-         uint8_t *out = outputs[i];
-         for (unsigned k = 0; k < size; k++)
-            out[k] -= 128;
+      if (!is_signed[i]) {
+         pipe_buffer_read(context, res, 0, size, outputs[i]);
+         continue;
+      }
+
+      struct pipe_transfer *transfer;
+      const uint8_t *map = pipe_buffer_map_range(context, res, 0, size,
+                                                 PIPE_MAP_READ, &transfer);
+      assert(map);
+
+      if (etna_buffer_cpu_read_cached(res)) {
+         flip_sign_bits(outputs[i], map, size);
+      } else {
+         /* Write-combined memory is read fastest with one bulk copy */
+         memcpy(outputs[i], map, size);
+         flip_sign_bits(outputs[i], outputs[i], size);
       }
+
+      pipe_buffer_unmap(context, transfer);
    }
 }
 
diff --git a/src/gallium/drivers/etnaviv/etnaviv_resource.c b/src/gallium/drivers/etnaviv/etnaviv_resource.c
index f8ad7bb26cba..117a939a410a 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_resource.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_resource.c
@@ -446,7 +446,7 @@ etna_buffer_bo_new(struct etna_screen *screen, const struct pipe_resource *prsc)
    /* As for textures: the cache maintenance of a cached BO is cheap on arm64,
     * and reading it back is much faster than reading write-combined memory.
     */
-   if (DETECT_ARCH_AARCH64 && (prsc->flags & ETNA_RESOURCE_FLAG_CPU_READ))
+   if (etna_buffer_cpu_read_cached(prsc))
       flags = DRM_ETNA_GEM_CACHE_CACHED;
 
    if (prsc->bind & PIPE_BIND_VERTEX_BUFFER)
diff --git a/src/gallium/drivers/etnaviv/etnaviv_resource.h b/src/gallium/drivers/etnaviv/etnaviv_resource.h
index ac86670941f2..8f55f5b5ca0b 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_resource.h
+++ b/src/gallium/drivers/etnaviv/etnaviv_resource.h
@@ -30,6 +30,7 @@
 #include "etnaviv_internal.h"
 #include "etnaviv_tiling.h"
 #include "pipe/p_state.h"
+#include "util/detect_arch.h"
 #include "util/format/u_format.h"
 #include "util/list.h"
 #include "util/u_helpers.h"
@@ -39,6 +40,15 @@
 
 #define ETNA_RESOURCE_FLAG_CPU_READ    (PIPE_RESOURCE_FLAG_DRV_PRIV << 0)
 
+/* A buffer the CPU reads back is allocated cached where the cache maintenance
+ * is cheap (arm64), and write-combined elsewhere.
+ */
+static inline bool
+etna_buffer_cpu_read_cached(const struct pipe_resource *prsc)
+{
+   return DETECT_ARCH_AARCH64 && (prsc->flags & ETNA_RESOURCE_FLAG_CPU_READ);
+}
+
 struct etna_context;
 struct etna_screen;
 struct pipe_screen;
