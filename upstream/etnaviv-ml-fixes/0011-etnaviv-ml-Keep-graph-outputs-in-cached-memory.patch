 src/gallium/drivers/etnaviv/etnaviv_ml.c      | 57 +++++++++++++++++--
 src/gallium/drivers/etnaviv/etnaviv_ml.h      |  4 +-
 .../drivers/etnaviv/etnaviv_resource.c        |  6 ++
 3 files changed, 61 insertions(+), 6 deletions(-)

diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml.c b/src/gallium/drivers/etnaviv/etnaviv_ml.c
index d9da88c5e788..24812bd45e73 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_ml.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml.c
@@ -82,7 +82,8 @@ etna_ml_create_tensor(struct etna_ml_subgraph *subgraph, unsigned idx, unsigned
       return;
    }
 
-   res = etna_ml_create_resource(&subgraph->screen->base, size);
+   res = etna_ml_create_resource(&subgraph->screen->base, size,
+                                 tensor->cpu_read);
    tensor->resource = res;
    tensor->size = size;
 
@@ -115,11 +116,29 @@ etna_ml_create_bo(struct etna_screen *screen, size_t size)
 }
 
 struct pipe_resource *
-etna_ml_create_resource(struct pipe_screen *pscreen, size_t size)
+etna_ml_create_resource(struct pipe_screen *pscreen, size_t size,
+                        bool cpu_read)
 {
-   struct pipe_resource *res = pipe_buffer_create(pscreen, 0, PIPE_USAGE_DEFAULT, size);
-   void *ptr = etna_bo_map(etna_buffer_resource(res)->bo);
-   memset(ptr, 0, pipe_buffer_size(res));
+   struct pipe_resource templ = {
+      .target = PIPE_BUFFER,
+      .format = PIPE_FORMAT_R8_UNORM,
+      .usage = PIPE_USAGE_DEFAULT,
+      /* Lets the driver put a buffer the CPU reads back in cached memory */
+      .flags = cpu_read ? ETNA_RESOURCE_FLAG_CPU_READ : 0,
+      .width0 = size,
+      .height0 = 1,
+      .depth0 = 1,
+      .array_size = 1,
+   };
+   struct pipe_resource *res = pscreen->resource_create(pscreen, &templ);
+   struct etna_bo *bo = etna_buffer_resource(res)->bo;
+
+   /* The prep / fini pair also writes the zeroes of a cached buffer back to
+    * memory, so no dirty line can overwrite what the NPU writes later.
+    */
+   etna_bo_cpu_prep(bo, DRM_ETNA_PREP_WRITE);
+   memset(etna_bo_map(bo), 0, pipe_buffer_size(res));
+   etna_bo_cpu_fini(bo);
 
    return res;
 }
@@ -543,6 +562,8 @@ lower_operations(struct etna_ml_subgraph *subgraph,
 
       for (int i = 0; i < poperation->output_count; i++) {
          struct etna_ml_tensor *tensor = etna_ml_get_tensor(subgraph, poperation->output_tensors[i]->index);
+         if (poperation->output_tensors[i]->is_external_output)
+            tensor->cpu_read = true;
          if (tensor->exp_layout == ETNA_ML_LAYOUT_ANY &&
              tensor->act_layout == ETNA_ML_LAYOUT_ANY) {
             ML_DBG("Copying layout to output tensor %d.\n", poperation->output_tensors[i]->index);
@@ -564,6 +585,32 @@ lower_operations(struct etna_ml_subgraph *subgraph,
       }
    }
 
+   /* The outputs of a bypass or a split live in their input's buffer, so
+    * when the CPU reads one of them back it reads that buffer.
+    */
+   for (bool changed = true; changed;) {
+      changed = false;
+      list_for_each_entry(struct etna_operation, op, etna_operations, link) {
+         if (op->type != ETNA_JOB_TYPE_BYPASS &&
+             op->type != ETNA_JOB_TYPE_SPLIT)
+            continue;
+
+         struct etna_ml_tensor *input =
+            etna_ml_get_tensor(subgraph, op->input_tensors[0]);
+         unsigned outputs =
+            op->type == ETNA_JOB_TYPE_SPLIT ? op->output_count : 1;
+
+         for (unsigned i = 0; i < outputs; i++) {
+            struct etna_ml_tensor *output =
+               etna_ml_get_tensor(subgraph, op->output_tensors[i]);
+            if (output->cpu_read && !input->cpu_read) {
+               input->cpu_read = true;
+               changed = true;
+            }
+         }
+      }
+   }
+
    list_for_each_entry(struct etna_operation, operation, etna_operations, link) {
       if (operation->type == ETNA_JOB_TYPE_CONCAT) {
          etna_ml_create_tensor(subgraph, operation->output_tensors[0], operation->output_tensor_sizes[0]);
diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml.h b/src/gallium/drivers/etnaviv/etnaviv_ml.h
