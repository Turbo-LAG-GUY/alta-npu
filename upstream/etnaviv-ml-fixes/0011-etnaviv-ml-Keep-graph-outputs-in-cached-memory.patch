@@ -53,6 +53,7 @@ struct etna_ml_tensor {
    unsigned size;
    enum etna_ml_tensor_layout exp_layout; /* expected */
    enum etna_ml_tensor_layout act_layout; /* actual */
+   bool cpu_read; /* read back by the CPU: a graph output or its buffer */
 };
 
 struct etna_ml_subgraph {
@@ -155,7 +156,8 @@ unsigned etna_ml_get_size(struct etna_ml_subgraph *subgraph, unsigned idx);
 
 struct etna_bo *etna_ml_create_bo(struct etna_screen *screen, size_t size);
 
-struct pipe_resource *etna_ml_create_resource(struct pipe_screen *pscreen, size_t size);
+struct pipe_resource *etna_ml_create_resource(struct pipe_screen *pscreen,
+                                              size_t size, bool cpu_read);
 
 struct etna_core_npu_info *etna_ml_get_core_info(struct etna_screen *screen);
 
diff --git a/src/gallium/drivers/etnaviv/etnaviv_resource.c b/src/gallium/drivers/etnaviv/etnaviv_resource.c
index 31c578a40722..f8ad7bb26cba 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_resource.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_resource.c
@@ -443,6 +443,12 @@ etna_buffer_bo_new(struct etna_screen *screen, const struct pipe_resource *prsc)
 {
    uint32_t flags = DRM_ETNA_GEM_CACHE_WC;
 
+   /* As for textures: the cache maintenance of a cached BO is cheap on arm64,
+    * and reading it back is much faster than reading write-combined memory.
+    */
+   if (DETECT_ARCH_AARCH64 && (prsc->flags & ETNA_RESOURCE_FLAG_CPU_READ))
+      flags = DRM_ETNA_GEM_CACHE_CACHED;
+
    if (prsc->bind & PIPE_BIND_VERTEX_BUFFER)
       flags |= DRM_ETNA_GEM_FORCE_MMU;
 
