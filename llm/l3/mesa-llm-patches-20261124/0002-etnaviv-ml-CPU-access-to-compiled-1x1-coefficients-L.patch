@@ -658,7 +659,21 @@ etna_ml_create_coeffs_v7(struct etna_ml_subgraph *subgraph, const struct etna_op
    bo_size = calculate_weight_bo_size(subgraph, operation);
    zrl_bits = calculate_zrl_bits(subgraph, operation);
 
-   struct etna_bo *compressed = etna_ml_create_bo(screen, bo_size);
+   struct etna_bo *compressed = etna_ml_create_coef_bo(screen, bo_size);
+
+   if (layout) {                     /* LLM engine (test tree only): etnaviv_ml_llm.h */
+      memset(layout, 0, sizeof(*layout));
+      layout->cores = cores_used;
+      layout->header_size = header_size;
+      layout->kernels_per_core = DIV_ROUND_UP(output_channels, cores_used);
+      layout->superblocks = etna_ml_calculate_tiling_v7(screen, operation, NULL, NULL);
+      layout->input_channels = input_channels;
+      layout->output_channels = output_channels;
+      layout->stride = operation->pointwise && output_channels > 8 ? MIN2(input_channels, 6) : 1;
+      layout->zrl_bits = zrl_bits;
+      layout->weight_zero_point = operation->weight_zero_point;
+      layout->pointwise = operation->pointwise && operation->weight_width == 1 && operation->weight_height == 1;
+   }
 
    etna_bo_cpu_prep(compressed, DRM_ETNA_PREP_WRITE);
 
