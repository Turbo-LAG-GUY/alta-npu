diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml.c b/src/gallium/drivers/etnaviv/etnaviv_ml.c
index 5a1b535e90c1..6fffacafdee2 100644
--- a/src/gallium/drivers/etnaviv/etnaviv_ml.c
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml.c
@@ -155,6 +155,53 @@ etna_ml_create_bo(struct etna_screen *screen, size_t size)
    return bo;
 }
 
+/* ETNA_ML_CACHED_COEFFS=1 (LLM engine, test tree only, 2026-11-24): coefficient BOs CPU-cached instead of
+ * write-combined, so the CPU can read the NPU's weights at memory speed (etna_ml_llm_coefs(): one-token decode on the
+ * CPU from the same buffers, no second copy). The CPU writes them once between cpu_prep and cpu_fini (the kernel
+ * cleans the caches for the NPU there); the NPU only reads them. */
+struct etna_bo *
+etna_ml_create_coef_bo(struct etna_screen *screen, size_t size)
+{
+   static int cached = -1;
+
+   if (cached < 0) {
+      const char *v = getenv("ETNA_ML_CACHED_COEFFS");
+      cached = v && atoi(v) > 0;
+   }
+   if (!cached)
+      return etna_ml_create_bo(screen, size);
+
+   struct etna_bo *bo = etna_ml_exact_bo() ?
+                        etna_bo_new_exact(screen->dev, size, DRM_ETNA_GEM_CACHE_CACHED) :
+                        etna_bo_new(screen->dev, size, DRM_ETNA_GEM_CACHE_CACHED);
+
+   etna_bo_cpu_prep(bo, DRM_ETNA_PREP_WRITE);
+   memset(etna_bo_map(bo), 0, size);
+   etna_bo_cpu_fini(bo);
+
+   return bo;
+}
+
+int
+etna_ml_llm_coefs(struct pipe_ml_subgraph *psubgraph, unsigned i, struct etna_ml_llm_coefs *out)
+{
+   struct etna_ml_subgraph *subgraph = (struct etna_ml_subgraph *)psubgraph;
+   unsigned n = 0;
+
+   util_dynarray_foreach(&subgraph->operations, struct etna_vip_instruction, inst) {
+      if (inst->type != ETNA_JOB_TYPE_NN || !inst->coefficients)
+         continue;
+      if (n++ != i)
+         continue;
+      *out = inst->llm_coefs;
+      out->map = etna_bo_map(inst->coefficients);
+      out->size = etna_bo_size(inst->coefficients);
+      return 0;
+   }
+
+   return -1;
+}
+
 struct pipe_resource *
 etna_ml_create_resource(struct pipe_screen *pscreen, size_t size,
                         bool cpu_read)
