diff --git a/src/gallium/drivers/etnaviv/etnaviv_ml_llm.h b/src/gallium/drivers/etnaviv/etnaviv_ml_llm.h
new file mode 100644
index 000000000000..a2226ee0a933
--- /dev/null
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml_llm.h
@@ -0,0 +1,44 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* LLM engine hooks (alta-npu, test tree only, 2026-11-24): the CPU reads a compiled NN job's coefficient buffer, so a
+ * program can run a model's linear layers on the CPU (one-token decode) from the very weights the NPU uses, without a
+ * second copy in memory. With ETNA_ML_CACHED_COEFFS=1 the coefficient buffers are CPU-cached (otherwise
+ * write-combined, slow to read).
+ *
+ * V7 1x1 (pointwise, zero-run bits 0) layout, from write_core_6 / write_core_interleaved: a header of `cores` uint32
+ * per-core stream sizes (header_size bytes), then the cores' streams back to back. A stream: zrl_bits (8 bits),
+ * kernels_per_core (16 bits), then per superblock (kernels_in_superblock = DIV_ROUND_UP(kernels_per_core,
+ * superblocks), the last one the rest), per block of `stride` input channels, per kernel: its `stride` weight bytes;
+ * the first block also has a 32-bit bias after its first weight and the last block a 32-bit output offset after its
+ * last weight. Kernel k of superblock sb on core c is output channel c * kis + k + sb * kis0 * cores (kis: this
+ * superblock's kernels, kis0: the first superblock's). Weights are bytes with weight_zero_point (signed weights are
+ * stored ^ 0x80). Output channels >= output_channels are padding.
+ */
+#ifndef ETNAVIV_ML_LLM_H
+#define ETNAVIV_ML_LLM_H
+
+#include <stdint.h>
+
+struct pipe_ml_subgraph;
+
+struct etna_ml_llm_coefs {
+   const uint8_t *map;          /* the coefficient BO, CPU-mapped */
+   uint32_t size;               /* its size in bytes */
+   uint32_t cores;              /* NN cores used */
+   uint32_t header_size;        /* bytes before core 0's stream */
+   uint32_t kernels_per_core;
+   uint32_t superblocks;
+   uint32_t input_channels;
+   uint32_t output_channels;
+   uint32_t stride;             /* input channels per block: 6 (write_core_6) or 1 (write_core_interleaved) */
+   uint32_t zrl_bits;           /* 0 for 1x1: one byte per weight (other values: not described here) */
+   uint32_t weight_zero_point;
+   uint32_t pointwise;          /* 1x1 convolution (the only layout described) */
+};
+
+/* the i-th NN job with coefficients, in execution order: 0, or -1 if there is none */
+int etna_ml_llm_coefs(struct pipe_ml_subgraph *subgraph, unsigned i, struct etna_ml_llm_coefs *out);
+
+#endif
