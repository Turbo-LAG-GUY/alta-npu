--- /dev/null
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml_axi_sram.h
@@ -0,0 +1,68 @@
+/*
+ * alta: placement of intermediate tensors in the NPU's AXI SRAM. A first-fit
+ * linear scan, kept free of Mesa types so it can be tested on its own.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef H_ETNAVIV_ML_AXI_SRAM
+#define H_ETNAVIV_ML_AXI_SRAM
+
+#include <stdbool.h>
+
+struct axi_sram_item {
+   unsigned size;      /* bytes, already rounded up to whole pages */
+   unsigned first_use; /* index of the operation that writes it */
+   unsigned last_use;  /* index of the last operation that reads it */
+   int offset;         /* result: byte offset in the SRAM, -1 if it stays in RAM */
+};
+
+/*
+ * Items must be sorted by first_use. Two items whose [first_use, last_use]
+ * ranges touch are live at once: an operation reads its input while it writes
+ * its output. Returns how many items were placed, at most max_placed.
+ */
+static inline unsigned
+axi_sram_assign(struct axi_sram_item *items, unsigned count, unsigned capacity, unsigned max_placed)
+{
+   unsigned placed = 0;
+
+   for (unsigned i = 0; i < count; i++) {
+      unsigned best = ~0u;
+
+      items[i].offset = -1;
+      if (placed >= max_placed || items[i].size > capacity)
+         continue;
+
+      /* The lowest free spot starts at 0 or right after a live block. */
+      for (int c = -1; c < (int)i; c++) {
+         unsigned start = 0;
+         bool clash = false;
+
+         if (c >= 0) {
+            if (items[c].offset < 0 || items[c].last_use < items[i].first_use)
+               continue;
+            start = (unsigned)items[c].offset + items[c].size;
+         }
+         if (start >= best || start + items[i].size > capacity)
+            continue;
+
+         for (unsigned j = 0; j < i && !clash; j++) {
+            clash = items[j].offset >= 0 && items[j].last_use >= items[i].first_use &&
+                    start < (unsigned)items[j].offset + items[j].size &&
+                    (unsigned)items[j].offset < start + items[i].size;
+         }
+         if (!clash)
+            best = start;
+      }
+
+      if (best != ~0u) {
+         items[i].offset = (int)best;
+         placed++;
+      }
+   }
+
+   return placed;
+}
+
+#endif
