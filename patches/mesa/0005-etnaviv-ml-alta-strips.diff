alta: ETNA_ML_STRIPS=auto|<n> splits chains of stride-1 3x3 convolutions into strips that run one after another in
the same submit, so each strip's in-between tensors stay in the AXI SRAM (needs 0002's ETNA_ML_AXI_SRAM).
Row strips: tested, correct. Column strips (needed for a channels-first output): hung the NPU in their first
test, off unless ETNA_ML_STRIPS_COLUMNS=1. Applies on top of 0002-0004.

--- a/src/gallium/drivers/etnaviv/etnaviv_ml.h
+++ b/src/gallium/drivers/etnaviv/etnaviv_ml.h
@@ -141,6 +141,16 @@
    unsigned pad_after_y;
    unsigned pad_before_z;
    unsigned pad_after_z;
+
+   /* alta: set on the convolutions that ETNA_ML_STRIPS makes (split_into_strips in etnaviv_ml.c). Rows are
+    * the TFLite height (the hardware's y), columns the TFLite width (its x). All zero otherwise, which
+    * changes nothing. */
+   bool strip;
+   bool strip_columns;             /* a strip of columns, not of rows */
+   int strip_offset;               /* hardware in_image_y_offset (rows) or _x_offset (columns): -1 pads, 0 reads real data */
+   unsigned strip_in_plane_rows;   /* rows per channel plane of the input buffer, if it isn't the input's own */
+   unsigned strip_in_row_pitch;    /* elements per row of the input buffer, if it isn't the input's own */
+   unsigned strip_out_row_pitch;   /* elements per row of the output buffer, if it isn't the output's own */
 };
 
