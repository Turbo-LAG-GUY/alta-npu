+++ b/src/gallium/drivers/etnaviv/etnaviv_ml_disk_cache.h
@@ -0,0 +1,361 @@
+/*
+ * alta: on-disk cache of compiled NPU weights, and the policy that keeps it from
+ * filling the disk. Free of Mesa types, so the idle trimmer and the unit test can
+ * build it on their own.
+ *
+ * Each entry is one file, <key>.npucache: a header, then the payload. Files are
+ * written under a temporary name and renamed, and checked when read, because
+ * this board gets hard resets and a damaged blob could hang the NPU.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef H_ETNAVIV_ML_DISK_CACHE
+#define H_ETNAVIV_ML_DISK_CACHE
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <time.h>
+#include <unistd.h>
+
+#define NPU_CACHE_DIGEST_SIZE 32
+#define NPU_CACHE_KEY_CHARS (NPU_CACHE_DIGEST_SIZE * 2 + 1) /* hex digits and NUL */
+#define NPU_CACHE_SUFFIX ".npucache"
+#define NPU_CACHE_TMP_PREFIX ".tmp."
+#define NPU_CACHE_MAGIC "NPUCACH1"
+#define NPU_CACHE_MIN_RESERVE (2ull << 30)   /* always leave at least this free */
+#define NPU_CACHE_NO_GROW_BELOW (10ull << 30) /* with less free than this, the cache stops growing */
+#define NPU_CACHE_MAX_ENTRY (512ull << 20)
+#define NPU_CACHE_STALE_TMP_SECONDS 3600
+
+struct npu_cache_file_header {
+   char magic[8];
+   uint64_t payload_size;
+   uint8_t digest[NPU_CACHE_DIGEST_SIZE];
+};
+
+#define NPU_CACHE_FILE_OVERHEAD (sizeof(struct npu_cache_file_header))
+
+typedef void (*npu_cache_digest_fn)(const void *data, size_t size,
+                                    uint8_t digest[NPU_CACHE_DIGEST_SIZE]);
+
+struct npu_cache_stats {
+   uint64_t total;   /* size of the filesystem */
+   uint64_t avail;   /* free space on it, after any eviction */
+   uint64_t used;    /* bytes the cache holds, after any eviction */
+   uint64_t budget;  /* bytes the cache may hold right now */
+   unsigned entries; /* entries left */
+   unsigned evicted; /* entries removed by this call */
+   bool low_space;   /* under NPU_CACHE_NO_GROW_BELOW free: the cache may not grow */
+};
+
+/*
+ * How many bytes the cache may hold. Its own files count as space it could give
+ * back, so the limit doesn't fall just because the cache grew. It leaves the
+ * larger of 5% of the disk or 2 GiB free, takes at most a quarter of what's
+ * beyond that, with no fixed ceiling. As the disk fills the limit falls, to
+ * zero once the reserve is reached; as space comes back it rises again.
+ * With less than 10 GiB free the cache may also not grow past its present size:
+ * a new entry is then stored only by evicting older ones to make room for it.
+ */
+static inline uint64_t
+npu_cache_budget(uint64_t total, uint64_t avail, uint64_t used)
+{
+   uint64_t reserve = total / 20 > NPU_CACHE_MIN_RESERVE ? total / 20 : NPU_CACHE_MIN_RESERVE;
+   uint64_t pool = avail + used > reserve ? avail + used - reserve : 0;
+
+   uint64_t budget = pool / 4;
+
+   if (avail < NPU_CACHE_NO_GROW_BELOW && used < budget)
+      budget = used;
+
+   return budget;
+}
+
+/* $ETNA_ML_DISK_CACHE_DIR, else $XDG_CACHE_HOME/teflon-npu, else ~/.cache/teflon-npu. */
+static inline bool
+npu_cache_default_dir(char *buf, size_t n)
+{
+   const char *dir = getenv("ETNA_ML_DISK_CACHE_DIR");
+   const char *xdg = getenv("XDG_CACHE_HOME");
+   const char *home = getenv("HOME");
+   int len;
+
+   if (dir && dir[0])
+      len = snprintf(buf, n, "%s", dir);
+   else if (xdg && xdg[0])
+      len = snprintf(buf, n, "%s/teflon-npu", xdg);
+   else if (home && home[0])
+      len = snprintf(buf, n, "%s/.cache/teflon-npu", home);
+   else
+      return false;
+
+   return len > 0 && (size_t)len < n;
+}
+
+static inline bool
+npu_cache_mkdirs(const char *dir)
+{
+   char path[PATH_MAX];
+   size_t len = strlen(dir);
+
+   if (len == 0 || len >= sizeof(path))
+      return false;
+   memcpy(path, dir, len + 1);
+
+   for (char *p = path + 1; *p; p++) {
+      if (*p == '/') {
+         *p = 0;
+         if (mkdir(path, 0700) && errno != EEXIST)
+            return false;
+         *p = '/';
+      }
+   }
+   return !mkdir(path, 0700) || errno == EEXIST;
+}
+
+static inline bool
+npu_cache_read_all(int fd, void *buf, size_t size)
+{
+   uint8_t *p = (uint8_t *)buf;
+
+   while (size) {
+      ssize_t n = read(fd, p, size);
+      if (n < 0 && errno == EINTR)
+         continue;
+      if (n <= 0)
+         return false;
+      p += n;
+      size -= (size_t)n;
+   }
+   return true;
+}
+
+static inline bool
+npu_cache_write_all(int fd, const void *buf, size_t size)
+{
+   const uint8_t *p = (const uint8_t *)buf;
+
+   while (size) {
+      ssize_t n = write(fd, p, size);
+      if (n < 0 && errno == EINTR)
+         continue;
+      if (n <= 0)
+         return false;
+      p += n;
+      size -= (size_t)n;
+   }
+   return true;
+}
+
+/*
+ * Returns the payload (malloc'd) and marks the entry as just used, or NULL if
+ * it's missing. A damaged entry is deleted and reported as missing.
+ */
+static inline void *
+npu_cache_read(const char *dir, const char *key, npu_cache_digest_fn digest, size_t *size)
+{
+   char path[PATH_MAX];
+   struct npu_cache_file_header header;
+   uint8_t computed[NPU_CACHE_DIGEST_SIZE];
+   struct stat st;
+   void *payload = NULL;
+   bool ok = false;
+   int len = snprintf(path, sizeof(path), "%s/%s%s", dir, key, NPU_CACHE_SUFFIX);
+
+   if (len <= 0 || (size_t)len >= sizeof(path))
+      return NULL;
+
+   int fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return NULL;
+
+   if (fstat(fd, &st) == 0 && (uint64_t)st.st_size >= sizeof(header) &&
+       npu_cache_read_all(fd, &header, sizeof(header)) &&
+       memcmp(header.magic, NPU_CACHE_MAGIC, sizeof(header.magic)) == 0 &&
+       header.payload_size <= NPU_CACHE_MAX_ENTRY &&
+       (uint64_t)st.st_size == sizeof(header) + header.payload_size &&
+       (payload = malloc(header.payload_size ? header.payload_size : 1)) != NULL &&
+       npu_cache_read_all(fd, payload, header.payload_size)) {
+      digest(payload, header.payload_size, computed);
+      ok = memcmp(computed, header.digest, sizeof(computed)) == 0;
+   }
+
+   if (ok) {
+      futimens(fd, NULL);
+      *size = header.payload_size;
+   } else {
+      free(payload);
+      payload = NULL;
+      unlink(path);
+   }
+   close(fd);
+
+   return payload;
+}
+
+/* Publishes the entry atomically. On any failure, such as a full disk, nothing is left behind. */
+static inline bool
+npu_cache_write(const char *dir, const char *key, npu_cache_digest_fn digest,
+                const void *payload, size_t size)
+{
+   char tmp[PATH_MAX], path[PATH_MAX];
+   struct npu_cache_file_header header;
+   int tmp_len = snprintf(tmp, sizeof(tmp), "%s/" NPU_CACHE_TMP_PREFIX "%d.%s", dir, (int)getpid(), key);
+   int path_len = snprintf(path, sizeof(path), "%s/%s%s", dir, key, NPU_CACHE_SUFFIX);
+
+   if (tmp_len <= 0 || (size_t)tmp_len >= sizeof(tmp) || path_len <= 0 ||
+       (size_t)path_len >= sizeof(path) || size > NPU_CACHE_MAX_ENTRY || !npu_cache_mkdirs(dir))
+      return false;
+
+   memcpy(header.magic, NPU_CACHE_MAGIC, sizeof(header.magic));
+   header.payload_size = size;
+   digest(payload, size, header.digest);
+
+   int fd = open(tmp, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+   if (fd < 0)
+      return false;
+
+   bool ok = npu_cache_write_all(fd, &header, sizeof(header)) &&
+             npu_cache_write_all(fd, payload, size);
+   if (close(fd))
+      ok = false;
+   if (!ok || rename(tmp, path)) {
+      unlink(tmp);
+      return false;
+   }
+   return true;
+}
+
+struct npu_cache_entry {
+   uint64_t size;
+   struct timespec used_at;
+   char name[NPU_CACHE_KEY_CHARS + sizeof(NPU_CACHE_SUFFIX)];
+};
+
+static inline int
+npu_cache_oldest_first(const void *pa, const void *pb)
+{
+   const struct npu_cache_entry *a = (const struct npu_cache_entry *)pa;
+   const struct npu_cache_entry *b = (const struct npu_cache_entry *)pb;
+
+   if (a->used_at.tv_sec != b->used_at.tv_sec)
+      return a->used_at.tv_sec < b->used_at.tv_sec ? -1 : 1;
+   if (a->used_at.tv_nsec != b->used_at.tv_nsec)
+      return a->used_at.tv_nsec < b->used_at.tv_nsec ? -1 : 1;
+   return strcmp(a->name, b->name);
+}
+
+/*
+ * Evicts least recently used entries until the cache, plus `incoming` new bytes,
+ * fits the budget for this much disk. Returns whether `incoming` fits. Something
+ * that can never fit evicts nothing on its behalf. total and avail are parameters
+ * so that tests can act out a filling disk.
+ */
+static inline bool
+npu_cache_trim_with(const char *dir, uint64_t total, uint64_t avail, uint64_t incoming,
+                    struct npu_cache_stats *stats)
+{
+   struct npu_cache_entry *entries = NULL;
+   size_t count = 0, capacity = 0, i = 0;
+   uint64_t used = 0;
+   unsigned evicted = 0;
+   bool fits = true;
+   DIR *d = opendir(dir);
+
+   if (d) {
+      struct dirent *e;
+      time_t now = time(NULL);
+
+      while ((e = readdir(d))) {
+         struct stat st;
+         size_t len = strlen(e->d_name);
+         const size_t name_len = NPU_CACHE_KEY_CHARS - 1 + sizeof(NPU_CACHE_SUFFIX) - 1;
+
+         if (fstatat(dirfd(d), e->d_name, &st, AT_SYMLINK_NOFOLLOW) || !S_ISREG(st.st_mode))
+            continue;
+         if (strncmp(e->d_name, NPU_CACHE_TMP_PREFIX, strlen(NPU_CACHE_TMP_PREFIX)) == 0) {
+            /* Left by a program that died mid-write. */
+            if (now - st.st_mtime > NPU_CACHE_STALE_TMP_SECONDS)
+               unlinkat(dirfd(d), e->d_name, 0);
+            continue;
+         }
+         if (len != name_len || strcmp(e->d_name + len - strlen(NPU_CACHE_SUFFIX), NPU_CACHE_SUFFIX))
+            continue;
+
+         if (count == capacity) {
+            size_t grown = capacity ? capacity * 2 : 64;
+            struct npu_cache_entry *more = (struct npu_cache_entry *)realloc(entries, grown * sizeof(*entries));
+            if (!more) {
+               free(entries);
+               closedir(d);
+               return false;
+            }
+            entries = more;
+            capacity = grown;
+         }
+         entries[count].size = (uint64_t)st.st_size;
+         entries[count].used_at = st.st_mtim;
+         memcpy(entries[count].name, e->d_name, len + 1);
+         used += entries[count].size;
+         count++;
+      }
+   }
+
+   uint64_t budget = npu_cache_budget(total, avail, used);
+   bool low_space = avail < NPU_CACHE_NO_GROW_BELOW;
+
+   if (incoming > budget) {
+      fits = false;
+      incoming = 0;
+   }
+
+   if (count)
+      qsort(entries, count, sizeof(*entries), npu_cache_oldest_first);
+   for (; i < count && used + incoming > budget; i++) {
+      unlinkat(dirfd(d), entries[i].name, 0);
+      used -= entries[i].size;
+      avail += entries[i].size;
+      evicted++;
+   }
+
+   if (stats) {
+      stats->total = total;
+      stats->avail = avail;
+      stats->used = used;
+      stats->budget = budget;
+      stats->entries = (unsigned)(count - i);
+      stats->evicted = evicted;
+      stats->low_space = low_space;
+   }
+
+   free(entries);
+   if (d)
+      closedir(d);
+
+   return fits;
+}
+
+/* The same, measuring the real filesystem. False if it can't be measured. */
+static inline bool
+npu_cache_trim(const char *dir, uint64_t incoming, struct npu_cache_stats *stats)
+{
+   struct statvfs fs;
+
+   if (statvfs(dir, &fs))
+      return false;
+
+   return npu_cache_trim_with(dir, (uint64_t)fs.f_blocks * fs.f_frsize,
+                              (uint64_t)fs.f_bavail * fs.f_frsize, incoming, stats);
+}
+
+#endif
