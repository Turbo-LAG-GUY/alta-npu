       dump_graph(delegate->tensors, tf_context->tensors_size, operations, params->nodes_to_replace->size);
 
+   /* alta (as upstream Mesa): tell the driver which tensors are read outside this partition, by a
+    * CPU layer or the caller, so it keeps them in memory the CPU can read. */
