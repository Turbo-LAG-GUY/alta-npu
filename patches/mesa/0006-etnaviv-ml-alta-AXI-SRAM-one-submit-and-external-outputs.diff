+   for (int i = 0; i < params->output_tensors->size; i++)
+      delegate->tensors[params->output_tensors->data[i]].is_external_output = false;
+
    struct teflon_subgraph *tsubgraph = calloc(1, sizeof(*tsubgraph));
    tsubgraph->base = subgraph;
 
