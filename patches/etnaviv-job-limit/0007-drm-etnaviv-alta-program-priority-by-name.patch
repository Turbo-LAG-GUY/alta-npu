+	/* alta: hw_job_prio, by the name of the program opening the NPU */
+	__get_task_comm(comm, sizeof(comm), current->group_leader);
+	mutex_lock(&etnaviv_prio_lock);
+	prio = etnaviv_prio_lookup(comm);
+	mutex_unlock(&etnaviv_prio_lock);
+
 	ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
 	if (!ctx)
 		return -ENOMEM;
