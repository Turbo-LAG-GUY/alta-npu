+++ b/drivers/gpu/drm/etnaviv/etnaviv_sched.c
@@ -114,6 +114,46 @@
 MODULE_PARM_DESC(hw_job_turns,
 		 "alta: jobs from different programs never share the ring (default: off)");
 
+/*
+ * alta: hw_job_prio_guard_ms (default 100, 0 = off), for program priority
+ * (hw_job_prio, etnaviv_drv.c).
+ * The scheduler always takes the next job from the highest priority that has
+ * one ready, so a lower-priority program runs in the gaps of a higher one. The
+ * NPU cannot pre-empt a job, though, and a lower-priority program that submits
+ * ahead could fill the ring just before the higher one's next job arrives. So
+ * while a higher-priority job has run within the last hw_job_prio_guard_ms, a
+ * lower-priority job enters only an empty ring (same mechanism as
+ * hw_job_turns): at most one of them is in the ring, and higher-priority jobs
+ * can still queue behind it. A higher-priority job then waits for at most the
+ * one lower-priority job already running.
+ */
+static unsigned int etnaviv_hw_jobs_prio_guard_ms = 100;
+module_param_named(hw_job_prio_guard_ms, etnaviv_hw_jobs_prio_guard_ms, uint, 0644);
+MODULE_PARM_DESC(hw_job_prio_guard_ms,
+		 "alta: after a higher-priority job, lower-priority jobs enter only an empty ring for this long (ms, default: 100, 0: off)");
+
+/* Safe under a spinlock. */
+static bool etnaviv_sched_higher_prio_active(struct etnaviv_gpu *gpu,
+					     enum drm_sched_priority prio)
+{
+	u64 guard = (u64)READ_ONCE(etnaviv_hw_jobs_prio_guard_ms) * NSEC_PER_MSEC;
+	u64 now;
+	int p;
+
+	if (!guard)
+		return false;
+
+	now = ktime_get_ns();
+	for (p = DRM_SCHED_PRIORITY_KERNEL; p < prio && p < DRM_SCHED_PRIORITY_COUNT; p++) {
+		u64 seen = READ_ONCE(gpu->alta_prio_seen[p]);
+
+		if (seen && now - seen < guard)
+			return true;
+	}
+
+	return false;
+}
