+/*
+ * alta: program priority by name.
+ *
+ * hw_job_prio holds up to ETNA_PRIO_NAMES rules "name=high|normal|low",
+ * separated by commas or newlines; name is the process name as in
+ * /proc/<pid>/comm (at most 15 characters). Programs not named run at normal,
+ * as in stock etnaviv. A program gets its priority when it opens the NPU, and
+ * writing the table also moves the programs that already have it open: their
+ * scheduler entities get the new priority, and drm_sched moves them to the new
+ * run queue at their next quiet moment (no job queued, the last one done; see
+ * drm_sched_entity_select_rq()). Bad rules are skipped with a warning, so a
+ * typo never stops the module from loading.
+ *
+ * The scheduler always takes the next job from the highest priority that has
+ * one ready; lower priorities run in the gaps. hw_job_prio_guard_ms
+ * (etnaviv_sched.c) keeps a lower-priority program from filling the ring right
+ * before a higher one's next job.
+ *
+ * hw_job_clients (read-only) lists the programs that have the NPU open:
+ * "<pid> <name> <priority> <applied|pending>" per line.
+ *
+ * Lock order: kernel_param_lock -> etnaviv_prio_lock -> dev->filelist_mutex
+ * -> gpu->sched_lock. A program that opens the NPU while the table is being
+ * written can miss that one write (it is added to the file list after open);
+ * the next write catches it.
+ */
+#define ETNA_PRIO_NAMES	16
+
+struct etnaviv_prio_rule {
+	char name[TASK_COMM_LEN];
+	enum drm_sched_priority prio;
+};
+
+static DEFINE_MUTEX(etnaviv_prio_lock);
+static struct etnaviv_prio_rule etnaviv_prio_rules[ETNA_PRIO_NAMES];
+static unsigned int etnaviv_prio_nrules;
+/* the registered drm device, for writes to hw_job_prio; NULL when unbound */
+static struct drm_device *etnaviv_prio_drm;
+
+static const char *etnaviv_prio_name(enum drm_sched_priority prio)
+{
+	switch (prio) {
+	case DRM_SCHED_PRIORITY_KERNEL:	return "kernel";
+	case DRM_SCHED_PRIORITY_HIGH:	return "high";
+	case DRM_SCHED_PRIORITY_NORMAL:	return "normal";
+	case DRM_SCHED_PRIORITY_LOW:	return "low";
+	default:			return "?";
+	}
+}
+
+/* etnaviv_prio_lock held */
+static enum drm_sched_priority etnaviv_prio_lookup(const char *comm)
+{
+	unsigned int i;
+
+	for (i = 0; i < etnaviv_prio_nrules; i++)
+		if (!strcmp(etnaviv_prio_rules[i].name, comm))
+			return etnaviv_prio_rules[i].prio;
+
+	return DRM_SCHED_PRIORITY_NORMAL;
+}
+
+/* The process name and pid of the program that has @file open. */
+static pid_t etnaviv_prio_file_comm(struct drm_file *file, char *comm,
+				    size_t len)
+{
+	struct task_struct *task;
+	struct pid *pid;
+	pid_t nr;
+
+	rcu_read_lock();
+	pid = rcu_dereference(file->pid);
+	task = pid_task(pid, PIDTYPE_TGID);
+	if (task)
+		__get_task_comm(comm, len, task);
+	else
+		strscpy(comm, "?", len);
+	nr = pid_vnr(pid);
+	rcu_read_unlock();
+
+	return nr;
+}
+
+/* dev->filelist_mutex held, so @file stays open */
+static void etnaviv_prio_set_file(struct etnaviv_drm_private *priv,
+				  struct drm_file *file,
+				  enum drm_sched_priority prio)
+{
+	struct etnaviv_file_private *ctx = file->driver_priv;
+	int i;
+
+	for (i = 0; i < ETNA_MAX_PIPES; i++) {
+		struct etnaviv_gpu *gpu = priv->gpu[i];
+		struct drm_sched_entity *entity = &ctx->sched_entity[i];
+
+		if (!gpu)
+			continue;
+
+		/*
+		 * drm_sched_entity_modify_sched() must not race with job arm
+		 * and push; etnaviv does both under gpu->sched_lock.
+		 */
+		mutex_lock(&gpu->sched_lock);
+		if (entity->priority != prio) {
+			drm_sched_entity_set_priority(entity, prio);
+			drm_sched_entity_modify_sched(entity,
+						      &gpu->alta_sched_list, 1);
+		}
+		mutex_unlock(&gpu->sched_lock);
+	}
+}
+
+/* etnaviv_prio_lock held */
+static void etnaviv_prio_apply_all(struct drm_device *dev)
+{
+	struct etnaviv_drm_private *priv = dev->dev_private;
+	char comm[TASK_COMM_LEN];
+	struct drm_file *file;
+
+	mutex_lock(&dev->filelist_mutex);
+	list_for_each_entry(file, &dev->filelist, lhead) {
+		etnaviv_prio_file_comm(file, comm, sizeof(comm));
+		etnaviv_prio_set_file(priv, file, etnaviv_prio_lookup(comm));
+	}
+	mutex_unlock(&dev->filelist_mutex);
+}
+
+static int etnaviv_prio_parse_level(const char *s,
+				    enum drm_sched_priority *prio)
+{
+	if (!strcmp(s, "high"))
+		*prio = DRM_SCHED_PRIORITY_HIGH;
+	else if (!strcmp(s, "normal"))
+		*prio = DRM_SCHED_PRIORITY_NORMAL;
+	else if (!strcmp(s, "low"))
+		*prio = DRM_SCHED_PRIORITY_LOW;
+	else
+		return -EINVAL;
+
+	return 0;
+}
+
+static int etnaviv_prio_param_set(const char *val,
+				  const struct kernel_param *kp)
+{
+	struct etnaviv_prio_rule *rules;
+	char *buf, *cur, *item;
+	unsigned int n = 0;
+
+	rules = kcalloc(ETNA_PRIO_NAMES, sizeof(*rules), GFP_KERNEL);
+	buf = kstrdup(val, GFP_KERNEL);
+	if (!rules || !buf) {
+		kfree(rules);
+		kfree(buf);
+		return -ENOMEM;
+	}
+
+	cur = buf;
+	while ((item = strsep(&cur, ",\n")) != NULL) {
+		enum drm_sched_priority prio;
+		char *eq, *name, *level;
+
+		item = strim(item);
+		if (!*item)
+			continue;
+
+		eq = strrchr(item, '=');
+		if (!eq) {
+			pr_warn("etnaviv: alta: hw_job_prio: skipping \"%s\" (want name=high|normal|low)\n",
+				item);
+			continue;
+		}
+		*eq = '\0';
+		name = strim(item);
+		level = strim(eq + 1);
+		if (!*name || strlen(name) >= TASK_COMM_LEN ||
+		    etnaviv_prio_parse_level(level, &prio)) {
+			pr_warn("etnaviv: alta: hw_job_prio: skipping \"%s=%s\" (name 1-%d characters, level high|normal|low)\n",
+				name, level, TASK_COMM_LEN - 1);
+			continue;
+		}
+		if (n == ETNA_PRIO_NAMES) {
+			pr_warn("etnaviv: alta: hw_job_prio: more than %d names, skipping the rest\n",
+				ETNA_PRIO_NAMES);
+			break;
+		}
+		strscpy(rules[n].name, name, sizeof(rules[n].name));
+		rules[n].prio = prio;
+		n++;
+	}
+	kfree(buf);
+
+	mutex_lock(&etnaviv_prio_lock);
+	memcpy(etnaviv_prio_rules, rules, sizeof(etnaviv_prio_rules));
+	etnaviv_prio_nrules = n;
+	if (etnaviv_prio_drm)
+		etnaviv_prio_apply_all(etnaviv_prio_drm);
+	mutex_unlock(&etnaviv_prio_lock);
+
+	kfree(rules);
+	return 0;
+}
+
+static int etnaviv_prio_param_get(char *buffer, const struct kernel_param *kp)
+{
+	unsigned int i;
+	int len = 0;
+
+	mutex_lock(&etnaviv_prio_lock);
+	for (i = 0; i < etnaviv_prio_nrules; i++)
+		len += scnprintf(buffer + len, PAGE_SIZE - len, "%s%s=%s",
+				 i ? "," : "", etnaviv_prio_rules[i].name,
+				 etnaviv_prio_name(etnaviv_prio_rules[i].prio));
+	mutex_unlock(&etnaviv_prio_lock);
+	len += scnprintf(buffer + len, PAGE_SIZE - len, "\n");
+
+	return len;
+}
+
+static const struct kernel_param_ops etnaviv_prio_param_ops = {
+	.set = etnaviv_prio_param_set,
+	.get = etnaviv_prio_param_get,
+};
+module_param_cb(hw_job_prio, &etnaviv_prio_param_ops, NULL, 0644);
+MODULE_PARM_DESC(hw_job_prio,
+		 "alta: program priority by process name, name=high|normal|low,... (default: everyone normal)");
+
+static int etnaviv_clients_param_get(char *buffer,
+				     const struct kernel_param *kp)
+{
+	char comm[TASK_COMM_LEN];
+	struct etnaviv_drm_private *priv;
+	struct drm_device *dev;
+	struct drm_file *file;
+	int len = 0;
+
+	mutex_lock(&etnaviv_prio_lock);
+	dev = etnaviv_prio_drm;
+	if (!dev)
+		goto out;
+	priv = dev->dev_private;
+
+	mutex_lock(&dev->filelist_mutex);
+	list_for_each_entry(file, &dev->filelist, lhead) {
+		struct etnaviv_file_private *ctx = file->driver_priv;
+		pid_t nr = etnaviv_prio_file_comm(file, comm, sizeof(comm));
+		int i;
+
+		for (i = 0; i < ETNA_MAX_PIPES; i++) {
+			struct etnaviv_gpu *gpu = priv->gpu[i];
+			struct drm_sched_entity *entity = &ctx->sched_entity[i];
+			enum drm_sched_priority prio;
+			bool applied;
+
+			if (!gpu)
+				continue;
+
+			mutex_lock(&gpu->sched_lock);
+			prio = entity->priority;
+			applied = prio < gpu->sched.num_rqs &&
+				  entity->rq == gpu->sched.sched_rq[prio];
+			mutex_unlock(&gpu->sched_lock);
+
+			len += scnprintf(buffer + len, PAGE_SIZE - len,
+					 "%d %s %s %s\n", nr, comm,
+					 etnaviv_prio_name(prio),
+					 applied ? "applied" : "pending");
+			break;	/* one line per program: the first pipe */
+		}
+	}
+	mutex_unlock(&dev->filelist_mutex);
+out:
+	mutex_unlock(&etnaviv_prio_lock);
+
+	return len;
+}
+
+static const struct kernel_param_ops etnaviv_clients_param_ops = {
+	.get = etnaviv_clients_param_get,
+};
+module_param_cb(hw_job_clients, &etnaviv_clients_param_ops, NULL, 0444);
+MODULE_PARM_DESC(hw_job_clients,
+		 "alta: programs with the NPU open: pid name priority applied|pending (read-only)");
+
