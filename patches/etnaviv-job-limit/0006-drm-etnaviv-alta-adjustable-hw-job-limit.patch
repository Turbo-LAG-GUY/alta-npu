@@ -96,6 +234,7 @@
 	.run_job = etnaviv_sched_run_job,
 	.timedout_job = etnaviv_sched_timedout_job,
 	.free_job = etnaviv_sched_free_job,
+	.update_job_credits = etnaviv_sched_update_job_credits,
 };
 
