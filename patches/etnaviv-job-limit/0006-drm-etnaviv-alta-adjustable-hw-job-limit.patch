+		 "alta: hw_job_limit %d (writable, 1-%d), hw_job_auto %s, hw_job_turns %s\n",
+		 READ_ONCE(etnaviv_hw_jobs_limit), ETNA_HW_JOBS_MAX,
+		 str_on_off(READ_ONCE(etnaviv_hw_jobs_auto)),
+		 str_on_off(READ_ONCE(etnaviv_hw_jobs_turns)));
+
 	return 0;
 }
 
